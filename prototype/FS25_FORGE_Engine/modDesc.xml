<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="111">
    <author>Sheridan Beer</author>
    <version>0.4.1.0</version>

    <title>
        <en>FORGE Engine</en>
    </title>

    <description>
        <en><![CDATA[
FORGE — Farming Operations & Regional Growth Engine.

Development foundation providing:
- Multiplayer-first mission lifecycle
- Savegame-embedded persistence
- Module registry
- Internal event bus
- Shared state store
- Data-driven campaign scaffolding

This development build adds the first XML-driven campaign and live Projects app integration.
        ]]></en>
    </description>

    <iconFilename>icon_forge.dds</iconFilename>
    <multiplayer supported="true"/>

    <extraSourceFiles>
        <!-- FORGE root namespace -->
        <sourceFile filename="scripts/forge/FORGE.lua"/>

        <!-- Authoritative definitions -->
        <sourceFile filename="scripts/forge/definitions/Definitions.lua"/>
        <sourceFile filename="scripts/forge/definitions/LogLevel.lua"/>
        <sourceFile filename="scripts/forge/definitions/LogSource.lua"/>

        <!-- Core services -->
        <sourceFile filename="scripts/forge/services/Logger.lua"/>
        <sourceFile filename="scripts/forge/services/EventBus.lua"/>
        <sourceFile filename="scripts/forge/services/StateStore.lua"/>

        <!-- Persistence implementation -->
        <sourceFile filename="scripts/forge/services/persistence/XMLWriter.lua"/>
        <sourceFile filename="scripts/forge/services/persistence/XMLReader.lua"/>

        <!-- Persistence coordination -->
        <sourceFile filename="scripts/forge/services/SaveManager.lua"/>

        <!-- Manual test harnesses -->
        <sourceFile filename="scripts/forge/tests/services/LoggerTest.lua"/>
        <sourceFile filename="scripts/forge/tests/services/EventBusTest.lua"/>
        <sourceFile filename="scripts/forge/tests/services/StateStoreTest.lua"/>
        <sourceFile filename="scripts/forge/tests/services/SaveManagerTest.lua"/>
        <sourceFile filename="scripts/forge/tests/persistence/XMLWriterTest.lua"/>

        <!-- Engine lifecycle registration must load last -->
        <sourceFile filename="scripts/forge/Engine.lua"/>
    </extraSourceFiles>

</modDesc>
