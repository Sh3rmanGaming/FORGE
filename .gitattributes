# Normalize text files to LF in the repository
* text=auto eol=lf

# Lua
*.lua text

# Markdown
*.md text

# XML
*.xml text

# Git
*.gitignore text
*.gitattributes text

# Images
*.png binary
*.dds binary
*.jpg binary
# Runtime evidence is recorded by SHA-256 in docs/reviews; store it byte-for-byte
docs/reviews/evidence/** -text
